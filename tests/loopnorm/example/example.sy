const int N = 4;
int A[8];
int sum_upto(int n) {
  int i = 0;
  int s = 0;
  while (i < n) {
    if (A[i] == 1) { i = i + 1; continue; }
    s = s + i;
    i = i + 1;
  }
  return s;
}
int main() {
  int k = 0;
  int i = 1;
  while (i < N - 1) {
    A[i] = i;
    i = i + 1;
  }
  while (k < 3) {
    k = k + 1;
  }
  return sum_upto(4) + k;
}
