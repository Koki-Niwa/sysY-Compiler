const int N = 3;
int g[2] = {7, 8};
float h[2] = {1, 0.5};
int f(int a[], int n) {
  int s = 0;
  int i = 0;
  while (i < n) {
    if (a[i] > 1) { s = s + a[i]; }
    i = i + 1;
  }
  return s;
}
int main() {
  int b[4] = {1, 2, 3, 4};
  int k = 3;
  int d[3] = {k, 2, 3};
  starttime();
  int r = f(b, k);
  stoptime();
  return r + g[1] + d[0] + h[0] / N;
}
