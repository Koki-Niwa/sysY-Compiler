int in[128] = {-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9,-3,4,-8,-1,6,-6,1,8,-4,3,-9,-2,5,-7,0,7,-5,2,9};
int w[9] = {-4,1,6,-2,3,-5,0,5,-3};
int out[64][64];
int main() {
  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      int acc = 0;
      int k = 0;
      while (k < 9) {
        acc = acc + in[j + k] * w[k];
        k = k + 1;
      }
      out[i][j] = acc;
      j = j + 1;
    }
    i = i + 1;
  }
  return out[3][4] + out[31][63];
}
